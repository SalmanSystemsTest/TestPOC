# ─────────────────────────────────────────────────────────────
# SSG Auto Parts — environment template
# Copy to .env.local and fill in. Commit THIS file, never .env.local.
# Every var must start with EXPO_PUBLIC_ or the app cannot read it.
# Restart `npx expo start` after any change — these are baked in at
# bundle time, not read live.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API Keys
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# 'dev'   = email + password. No SMS provider needed. Use this now.
# 'phone' = phone + SMS OTP. Requires Twilio configured in Supabase.
EXPO_PUBLIC_AUTH_MODE=dev

# SSG's sales WhatsApp number, digits only, country code first.
# Used by the "Contact SSG" button. Placeholder is fine for now.
EXPO_PUBLIC_SSG_WHATSAPP=

# Optional. Shown on the "not registered" screen so rejected users
# know who to call. Placeholder is fine for now.
EXPO_PUBLIC_SSG_PHONE=
